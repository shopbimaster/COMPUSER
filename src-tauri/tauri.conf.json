{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CAMPUSER",
  "version": "2.0.0",
  "identifier": "com.campuser.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CAMPUSER",
        "width": 1280,
        "height": 860,
        "minWidth": 860,
        "minHeight": 600,
        "url": "app/index.html"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ]
  }
}
