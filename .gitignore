# ---- 依赖与构建产物 ----
node_modules/
dist/
# build/ 下为图标与 NSIS 脚本等源码资产；ignore 用 /* 而非 /，
# 否则目录级排除会令 !build/installer.nsh 的负模式失效
build/*
!build/installer.nsh
*.log

# ---- 发布产物 ----
release/

# ---- 凭据（GitHub PAT，仅本地使用，严禁入库）----
campus.token

# ---- 运行时数据（课表数据与 Electron 便携配置，均属本地状态）----
data/
.electron-cache/

# ---- 本地测试素材（含个人课表数据，不入库）----
测试文件/

# ---- 原版参考代码（仅本地行为参考，不入库：原仓库无开源许可）----
_reference/

# ---- UI 参考效果图（新版 WakeUp 截图，仅本地设计参考）----
UI效果图/

# ---- 系统与编辑器 ----
.DS_Store
Thumbs.db
desktop.ini
*.swp
.idea/
.vscode/
